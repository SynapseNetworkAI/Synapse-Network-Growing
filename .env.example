# ── LLM Provider ──────────────────────────────────────────────
# Supported: openai | claude | copilot
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=300

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# ── Anthropic Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── GitHub Copilot ────────────────────────────────────────────
GITHUB_TOKEN=
COPILOT_BASE_URL=https://api.githubcopilot.com

# ── Server ────────────────────────────────────────────────────
OPS_ENV=local
OPS_HOST=127.0.0.1
OPS_PORT=9600
OPS_LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────
# OPS_DB_PATH=
# OPS_DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────
OPS_CORS_ORIGINS=*
