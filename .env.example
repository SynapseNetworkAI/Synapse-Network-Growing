# ── LLM Provider ──────────────────────────────────────────────
# Supported: openai | claude | copilot | codex
# These LLM_* settings are the primary configuration surface.
# Runtime selection is resolved from:
#   1. explicit ORCHESTRATION_BACKEND override, if set
#   2. otherwise LLM_PROVIDER + LLM_EXECUTION_MODE
# Examples:
#   openai + sync    -> legacy
#   openai + session -> openai_responses
#   copilot + session -> copilot_sdk
#   codex + sync/session -> codex_cli unless ORCHESTRATION_BACKEND=codex_sdk is explicit
# LLM_MODEL examples by provider (actual availability depends on your account/base URL):
#   openai: gpt-4o | gpt-4.1 | gpt-4.1-mini | o4-mini
#   claude: claude-3-5-sonnet-latest | claude-3-5-haiku-latest | claude-3-7-sonnet-latest
#   copilot (verified against the direct Copilot API with the current local Copilot CLI OAuth token on 2026-04-09):
#     gpt-4o
#     gpt-4o-2024-11-20
#     gpt-4o-2024-08-06
#     gpt-4o-mini
#     gpt-4o-mini-2024-07-18
#     gpt-3.5-turbo
#     gpt-3.5-turbo-0613
#   note: VS Code Copilot Chat may show UI labels such as GPT-5.4 or GPT-5.4 High.
#   Those labels were not accepted by the direct /chat/completions path used by this backend with the local CLI OAuth token.
#   note: `COPILOT_SDK_MODEL` is a separate setting for ORCHESTRATION_BACKEND=copilot_sdk.
#   It is not constrained to the exact same accepted values as the direct `LLM_PROVIDER=copilot` path.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_EXECUTION_MODE=sync
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=300

# Social Content / Distribution uses a dedicated copy provider configuration.
# This is independent from LLM_PROVIDER / CODEX_CLI_MODEL used by planner and workflow execution.
# Current local Codex ChatGPT accounts have verified gpt-5.4 for this path; do not default to
# gpt-5-codex unless your Codex account explicitly supports it.
SOCIAL_CONTENT_LLM_PROVIDER=codex
SOCIAL_CONTENT_LLM_MODEL=gpt-5.4
SOCIAL_CONTENT_LLM_FALLBACK_MODEL=gpt-5.4
SOCIAL_CONTENT_LLM_TIMEOUT=60

# ── Database ──────────────────────────────────────────────────
# PostgreSQL is required for runtime, local dev, tests, and CI.
# Start docker-compose.postgres.yml locally and use:
OPS_DATABASE_URL=postgresql+psycopg://synapse_growing:synapse_growing_dev@127.0.0.1:54329/synapse_growing_local
# Optional dedicated test DB. CI sets this explicitly.
OPS_TEST_POSTGRES_URL=postgresql+psycopg://synapse_growing:synapse_growing_dev@127.0.0.1:54329/synapse_growing_test
# OPS_DB_POOL_SIZE=12
# OPS_DB_MAX_OVERFLOW=24

# ── Plan Agent Adapter ───────────────────────────────────────
# Optional planner-only override. Leave empty to infer from ORCHESTRATION_BACKEND,
# then LLM_PROVIDER. Supported: openai | claude | copilot | codex_cli | codex_sdk
PLANNER_BACKEND=
# Optional model override for plan agent / acceptance / verification provider calls.
# Leave empty to use the selected backend's model defaults.
PLANNER_MODEL=
PLANNER_TIMEOUT=300

# ── Task Orchestration ───────────────────────────────────────
# Optional override only.
# Leave empty in most setups and let LLM_PROVIDER + LLM_EXECUTION_MODE select the runtime.
# Supported overrides: legacy | openai_responses | copilot_sdk | codex_cli | codex_sdk
# ORCHESTRATION_BACKEND=
# Use the exact model id returned by Copilot SDK models.list.
# Model ids are case-sensitive.
# Examples observed locally on 2026-04-09: gpt-4.1, gpt-5.4, claude-sonnet-4.6
COPILOT_SDK_MODEL=gpt-4.1
# Timeout in seconds for a single sendAndWait turn.
# Set to 0 to disable the client-side timeout entirely.
COPILOT_SDK_TIMEOUT=300
# Background monitor for detached long-running sessions.
# Disable only in tightly controlled test environments.
COPILOT_SDK_MONITOR_ENABLED=true
# Poll running Copilot SDK tasks every N seconds for new events / terminal state.
COPILOT_SDK_POLL_INTERVAL_SEC=3
# If no worker heartbeat arrives for this many seconds, backend will try resumeSession recovery.
COPILOT_SDK_STALE_AFTER_SEC=30
# Unattended task runner defaults: auto-answer ask_user and avoid hanging on prompts.
COPILOT_SDK_AUTO_USER_INPUT=true
COPILOT_SDK_AUTO_USER_INPUT_TEXT=Proceed automatically using best effort. Do not wait for additional user input.
COPILOT_SDK_NODE_BIN=node
COPILOT_SDK_RUNNER_PATH=./copilot-sdk-runner/run_session.mjs
# Optional DB analyst MCP attachment. Keep empty to disable.
COPILOT_SDK_DB_ANALYST_MCP_COMMAND=
COPILOT_SDK_DB_ANALYST_MCP_ARGS_JSON=[]
OPENAI_RESPONSES_MONITOR_ENABLED=true
OPENAI_RESPONSES_POLL_INTERVAL_SEC=3

# ── Codex Python SDK / CLI ───────────────────────────────────
# codex_sdk is the planned Python SDK backend for planner execution.
# It still requires codex app-server / codex-cli-bin and keeps codex_cli as fallback for task execution.
CODEX_SDK_MODEL=gpt-5.4
CODEX_SDK_TIMEOUT=0
CODEX_SDK_PLAN_TIMEOUT=300
CODEX_SDK_MAX_ACTIVE_SECONDS=7200
CODEX_SDK_STALE_AFTER_SEC=300
CODEX_SDK_SANDBOX=workspace-write
CODEX_CLI_MODEL=gpt-5-codex
CODEX_CLI_TIMEOUT=300
CODEX_CLI_TASK_TIMEOUT=0
CODEX_CLI_SANDBOX=workspace-write
CODEX_CLI_FULL_AUTO=true
CODEX_CLI_MONITOR_ENABLED=true
CODEX_CLI_STALE_AFTER_SEC=180
CODEX_CLI_MAX_ACTIVE_SECONDS=3600

# ── Alerting / Runtime Guard ─────────────────────────────────
# When Copilot SDK returns an explicit authorization / enterprise-policy error,
# send a Lark alert and pause the task + parent requirement instead of continuing.
OPS_RUNTIME_AUTH_ALERTS_ENABLED=true

# Lark webhook routing:
# 1. OPS_LARK_BOT_WEBHOOK_URL is the shared fallback bot. Alert and approval
#    channels fall back to this value when their dedicated webhook is empty.
# 2. OPS_LARK_REQUIREMENT_WEBHOOK_URL routes workflow/requirement notifications:
#    requirement_created, workflow_run_started/succeeded, workflow_assets_failed.
# 3. OPS_LARK_ALERT_WEBHOOK_URL routes only interruptive P0/P1 alerts:
#    high-severity errors, retry budget exhausted, runner stale/crash, kill switch,
#    funds/settlement/auth/contract/production risks.
# 4. OPS_LARK_APPROVAL_WEBHOOK_URL routes human decisions:
#    human_gate_request.created/decided, manual approval, deploy approval,
#    approve/reject/continue_retry receipts.
# 5. OPS_LARK_RELEASE_WEBHOOK_URL routes delivery/release activity:
#    pr_opened, pr_creation_failed, release_blocked, CI/deploy/observing results.
# 6. *_KEYWORD values are inserted into the Lark card title and body. Configure
#    them to match each bot's security keyword, for example 需求 / 告警 / 审批 / 发布.
# Leave a dedicated webhook empty to skip that channel locally, except alert and
# approval which use OPS_LARK_BOT_WEBHOOK_URL as fallback.
# Set OPS_LARK_DELIVERY_DRY_RUN=true for smoke tests or local validation when
# real webhooks are configured. The system still creates notification delivery
# records and cards, but it will not call Lark.
OPS_LARK_BOT_WEBHOOK_URL=
OPS_LARK_BOT_KEYWORD=告警
OPS_LARK_REQUIREMENT_WEBHOOK_URL=
OPS_LARK_REQUIREMENT_KEYWORD=需求
OPS_LARK_ALERT_WEBHOOK_URL=
OPS_LARK_ALERT_KEYWORD=告警
OPS_LARK_APPROVAL_WEBHOOK_URL=
OPS_LARK_APPROVAL_KEYWORD=审批
OPS_LARK_RELEASE_WEBHOOK_URL=
OPS_LARK_RELEASE_KEYWORD=发布
OPS_LARK_DELIVERY_DRY_RUN=false

# Notification queue / suppression:
# Business code enqueues notification_events; the dispatcher applies fingerprint
# dedupe, per-channel rate limits, cooldowns, retry, and dead-letter handling.
OPS_NOTIFICATION_DISPATCHER_ENABLED=true
OPS_NOTIFICATION_DISPATCH_INTERVAL_SECONDS=5
OPS_NOTIFICATION_ALERT_BURST_PER_MINUTE=5
OPS_NOTIFICATION_DEFAULT_COOLDOWN_SECONDS=900
OPS_NOTIFICATION_P0_COOLDOWN_SECONDS=300
OPS_NOTIFICATION_P1_COOLDOWN_SECONDS=900
OPS_NOTIFICATION_APPROVAL_REMINDER_SECONDS=7200
OPS_NOTIFICATION_MAX_DELIVERY_ATTEMPTS=4

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# ── Anthropic Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── GitHub Copilot ────────────────────────────────────────────
# Token/env priority aligned with Copilot SDK docs:
#   COPILOT_GITHUB_TOKEN -> GH_TOKEN -> GITHUB_TOKEN -> stored `copilot login` credentials
# Use COPILOT_GITHUB_TOKEN when you have an explicit token for Copilot SDK / CLI automation.
# Important: the legacy LLM_PROVIDER=copilot direct /chat/completions path in this repo does not accept
# Personal Access Tokens (`github_pat_...` / `ghp_...`). For that path, use `copilot login` or an OAuth user token.
COPILOT_GITHUB_TOKEN=
GH_TOKEN=
# Preferred interactive path: login once with `copilot login`; backend will reuse ~/.config/github-copilot/apps.json.
# Repo-specific compatibility override for existing local setups that already use a Copilot OAuth token (`gho_...`):
COPILOT_OAUTH_TOKEN=
# GitHub-compatible fallback token slot used by the Copilot SDK docs and CLI examples.
GITHUB_TOKEN=
COPILOT_BASE_URL=https://api.githubcopilot.com

# ── Server ────────────────────────────────────────────────────
OPS_ENV=local
OPS_HOST=127.0.0.1
OPS_PORT=9600
OPS_LOG_LEVEL=debug
X_OAUTH_REDIRECT_URI=http://127.0.0.1:9600/api/social/x/oauth/callback

# ── CORS ──────────────────────────────────────────────────────
OPS_CORS_ORIGINS=*
