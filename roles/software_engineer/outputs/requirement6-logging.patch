+def _resolve_retention(value: int | str | None) -> int:
+    try:
+        retention = int(value) if value is not None else _DEFAULT_RETENTION_DAYS
+    except (TypeError, ValueError):
+        retention = _DEFAULT_RETENTION_DAYS
+    return max(1, retention)
