+def _coerce_level(value: str | int | None) -> int:
+    if isinstance(value, int):
+        return value
+    if isinstance(value, str):
+        level = getattr(logging, value.upper(), None)
+        if isinstance(level, int):
+            return level
+    return logging.INFO
+
