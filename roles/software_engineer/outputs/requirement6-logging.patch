diff --git a/services/gateway/tests/unit/test_log_config_unit.py b/services/gateway/tests/unit/test_log_config_unit.py
new file mode 100644
index 00000000..268c3338
--- /dev/null
+++ b/services/gateway/tests/unit/test_log_config_unit.py
@@ -0,0 +1,49 @@
+from __future__ import annotations
+
+import logging
+from logging.handlers import TimedRotatingFileHandler
+
+from src.core import log_config
+
+
+def _flush_handlers(logger: logging.Logger) -> None:
+    for handler in logger.handlers:
+        handler.flush()
+
+
+def test_setup_logger_writes_rotating_file(tmp_path, monkeypatch) -> None:
+    log_config.reset_logging_for_tests()
+    monkeypatch.setenv("GATEWAY_LOG_DIR", str(tmp_path))
+    monkeypatch.setenv("GATEWAY_LOG_FILE", "gateway-test.log")
+    monkeypatch.setenv("GATEWAY_LOG_LEVEL", "INFO")
+    monkeypatch.setenv("GATEWAY_LOG_RETENTION_DAYS", "2")
+
+    root_logger = log_config.setup_logger()
+    logging.getLogger("synapse.test").info("hello world", extra={"request_id": "REQ-42"})
+    _flush_handlers(root_logger)
+
+    log_path = tmp_path / "gateway-test.log"
+    assert log_path.exists()
+    contents = log_path.read_text(encoding="utf-8")
+    assert "hello world" in contents
+    assert "REQ-42" in contents
+    assert any(isinstance(handler, TimedRotatingFileHandler) for handler in root_logger.handlers)
+
+    log_config.reset_logging_for_tests()
+
+
+def test_setup_logger_injects_default_request_id(tmp_path, monkeypatch) -> None:
+    log_config.reset_logging_for_tests()
+    monkeypatch.setenv("GATEWAY_LOG_DIR", str(tmp_path))
+    monkeypatch.setenv("GATEWAY_LOG_FILE", "gateway-default.log")
+
+    root_logger = log_config.setup_logger()
+    logging.getLogger("synapse.test").info("missing extra context")
+    _flush_handlers(root_logger)
+
+    log_path = tmp_path / "gateway-default.log"
+    contents = log_path.read_text(encoding="utf-8")
+    assert "missing extra context" in contents
+    assert "SYS" in contents
+
+    log_config.reset_logging_for_tests()
